# ==============================================================================
# GOUNA LIFESTYLE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Application Environment & Core Settings
APP_NAME=Gounow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.gounow.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging Configuration
# In production, daily rotating logs or stack with level=info/notice is required.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# Database Configuration (PostgreSQL Target for Production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gounow_production
DB_USERNAME=gounow_user
DB_PASSWORD=
DB_SSLMODE=prefer

# Session Configuration (Must be database or redis in multi-instance production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Cache & Locks (Must be database or redis in multi-instance production)
CACHE_STORE=database
CACHE_PREFIX=gounow_cache_

# Queue Configuration (Must be database, redis, or sqs in production)
QUEUE_CONNECTION=database

# Filesystem & Media Storage
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS & Trusted Proxies (Strict Origin Whitelist; No Wildcards with Credentials)
CORS_ALLOWED_ORIGINS=https://gounow.com,https://www.gounow.com,https://admin.gounow.com
SANCTUM_STATEFUL_DOMAINS=gounow.com,www.gounow.com,admin.gounow.com
TRUSTED_PROXIES=*

# Mail Transport Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@gounow.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateway Credentials & Webhook Secrets
PAYMENT_WEBHOOK_SECRET=
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_INSTAPAY_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_MERCHANT_ID=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL="http://localhost:3000"

# Redis (Optional if using redis for cache/session/queue)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Memcached (Optional)
MEMCACHED_HOST=127.0.0.1

# Third-Party Notifications
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
POSTMARK_TOKEN=
RESEND_KEY=
